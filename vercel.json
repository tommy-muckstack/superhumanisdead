{
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "npm run build:web",
  "outputDirectory": "out/web",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/superhumanisdead/ingest/static/:path*", "destination": "https://us-assets.i.posthog.com/static/:path*" },
    { "source": "/superhumanisdead/ingest/:path*", "destination": "https://us.i.posthog.com/:path*" },
    { "source": "/superhumanisdead", "destination": "/" },
    { "source": "/superhumanisdead/signup", "destination": "/login/?mode=signup" },
    { "source": "/superhumanisdead/app", "destination": "/" },
    { "source": "/superhumanisdead/login", "destination": "/login" },
    { "source": "/superhumanisdead/:path*", "destination": "/:path*" }
  ]
}
